# ESP32-C6 defaults for the XMPL100 examples (merged with idf.py set-target).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# The driver is built like the host tests: no exceptions, no RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Org standard: FreeRTOS runs at 1000 Hz. vTaskDelay() rounds a nonzero delay up to one tick, so
# millisecond waits need a 1 ms tick.
CONFIG_FREERTOS_HZ=1000
