/**
 * @file test_errors.cpp
 * @brief Every `Error` value is returned by some call, and the base values keep their numbers.
 */
#include <cstring>

#include "@ROOT@/MovingAverage.h"
#include "test_harness.hpp"

using xmpl100::Error;

static_assert(static_cast<int>(Error::Ok) == 0 && static_cast<int>(Error::NotInitialized) == 1 &&
                  static_cast<int>(Error::InvalidArgument) == 2,
              "base Error values follow the shared base set");

TEST_CASE("Every Error value is returned by some call") {
  bool seen[256] = {};
  {
    xmpl100::MovingAverage<4> zero(xmpl100::Config{0, 0.0F});
    seen[static_cast<uint8_t>(zero.Push(1.0F).error)] = true;          // NotInitialized
    seen[static_cast<uint8_t>(zero.EnsureInitialized().error)] = true; // InvalidArgument
    xmpl100::MovingAverage<4> wide;                                    // window 8 > capacity 4
    seen[static_cast<uint8_t>(wide.EnsureInitialized().error)] = true; // InvalidArgument
    xmpl100::MovingAverage<4> avg(xmpl100::Config{4, 0.0F});
    seen[static_cast<uint8_t>(avg.EnsureInitialized().error)] = true; // Ok
    seen[static_cast<uint8_t>(avg.Average().error)] = true;           // Empty
  }
  for (int v = 0; v < 256; ++v) {
    const auto e = static_cast<Error>(v);
    if (std::strcmp(xmpl100::ToString(e), "Unknown") == 0) {
      continue;
    }
    if (!seen[v]) {
      std::printf("    Error::%s is never returned\n", xmpl100::ToString(e));
    }
    CHECK(seen[v]);
    CHECK(v < 10 || v >= 16);
  }
}
