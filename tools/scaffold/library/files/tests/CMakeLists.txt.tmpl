# =============================================================================
# @TITLE@: host tests
# =============================================================================
# Built with the firmware's flags (-fno-exceptions -fno-rtti) and warnings as
# errors. No hardware, no ESP-IDF:
#
#   cmake -S . -B build -DXMPL100_BUILD_TESTS=ON
#   cmake --build build
#   ctest --test-dir build --output-on-failure
# =============================================================================

# ISO C++20, never the GNU dialect (handbook KB-CPP20-001): set here too, so that this folder is strict
# whoever includes it.
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# -pedantic-errors and the C++20 deprecations as errors (KB-CPP20-001, -003).
set(XMPL100_TEST_FLAGS -fno-exceptions -fno-rtti -Wall -Wextra -Wpedantic -pedantic-errors -Wshadow
    -Wconversion -Wsign-conversion -Wdeprecated -Wdeprecated-enum-enum-conversion
    -Wdeprecated-enum-float-conversion -Wimplicit-fallthrough -Werror)
# The standard library's own bounds checks, so an out-of-range span or array access traps in the tests
# and fuzzers (KB-CPP20-043).
set(XMPL100_TEST_DEFINITIONS _GLIBCXX_ASSERTIONS=1 _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST)

function(xmpl100_test_target name)
  target_link_libraries(${name} PRIVATE xmpl100::xmpl100)
  target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/host)
  target_compile_features(${name} PRIVATE cxx_std_20)
  target_compile_options(${name} PRIVATE ${XMPL100_TEST_FLAGS})
  target_compile_definitions(${name} PRIVATE ${XMPL100_TEST_DEFINITIONS})
endfunction()

# --- Strict-dialect header checks ---------------------------------------------
# One translation unit per public header (and through the driver header its src/ .ipp): each header
# compiles on its own, first in its unit, as ISO C++20 with -pedantic-errors, and the unit asserts
# that the dialect really is C++20 (handbook KB-CPP20-001, checks strict-dialect and
# header-self-contained). They build with the host tests on GCC and Clang and, as part of
# xmpl100_optimised_build, in the Cortex-M cross-build.
file(GLOB_RECURSE XMPL100_PUBLIC_HEADERS CONFIGURE_DEPENDS ${PROJECT_SOURCE_DIR}/inc/*.hpp
  ${PROJECT_SOURCE_DIR}/inc/*.h)
set(XMPL100_HEADER_CHECKS)
foreach(header ${XMPL100_PUBLIC_HEADERS} ${XMPL100_VERSION_HEADER})
  if(header STREQUAL XMPL100_VERSION_HEADER)
    file(RELATIVE_PATH rel ${XMPL100_VERSION_HEADER_DIR} ${header})
  else()
    file(RELATIVE_PATH rel ${PROJECT_SOURCE_DIR}/inc ${header})
  endif()
  string(MAKE_C_IDENTIFIER "${rel}" id)
  set(check ${CMAKE_CURRENT_BINARY_DIR}/header_checks/${id}.cpp)
  string(CONCAT content "// Generated by tests/CMakeLists.txt: ${rel} compiles on its own as ISO C++20.\n"
    "#include \"${rel}\"\n"
    "static_assert(__cplusplus == 202002L, \"the strict-dialect check must build as -std=c++20\");\n")
  if(EXISTS ${check})
    file(READ ${check} old)
  else()
    set(old "")
  endif()
  if(NOT old STREQUAL content)
    file(WRITE ${check} "${content}")
  endif()
  list(APPEND XMPL100_HEADER_CHECKS ${check})
endforeach()
add_library(xmpl100_header_checks OBJECT ${XMPL100_HEADER_CHECKS})
xmpl100_test_target(xmpl100_header_checks)

# --- Unit tests (tests/host/) --------------------------------------------------
file(GLOB XMPL100_UNIT_TESTS CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/host/test_*.cpp)
list(FILTER XMPL100_UNIT_TESTS EXCLUDE REGEX "test_(main|version|kconfig)\\.cpp$")
add_executable(xmpl100_host_tests host/test_main.cpp ${XMPL100_UNIT_TESTS})
xmpl100_test_target(xmpl100_host_tests)
add_test(NAME xmpl100_host_tests COMMAND xmpl100_host_tests)

add_library(xmpl100_optimised_build OBJECT ${XMPL100_UNIT_TESTS} ${XMPL100_HEADER_CHECKS})
xmpl100_test_target(xmpl100_optimised_build)
target_compile_options(xmpl100_optimised_build PRIVATE -O2)

# --- Kconfig layer: without and with CONFIG_ values ---------------------------
add_executable(xmpl100_kconfig_defaults host/test_main.cpp host/test_kconfig.cpp)
xmpl100_test_target(xmpl100_kconfig_defaults)
add_test(NAME xmpl100_kconfig_defaults COMMAND xmpl100_kconfig_defaults)

add_executable(xmpl100_kconfig_set host/test_main.cpp host/test_kconfig.cpp)
xmpl100_test_target(xmpl100_kconfig_set)
target_compile_definitions(xmpl100_kconfig_set PRIVATE KCONFIG_SET=1 CONFIG_XMPL100=1
  CONFIG_XMPL100_WINDOW_SAMPLES=16)
add_test(NAME xmpl100_kconfig_set COMMAND xmpl100_kconfig_set)

# --- Version: the getters, and every copy of the version string ---------------
function(xmpl100_version_test name include_dir major minor patch)
  add_executable(${name} host/test_version.cpp)
  if(include_dir)
    target_include_directories(${name} BEFORE PRIVATE ${include_dir})
  endif()
  xmpl100_test_target(${name})
  target_compile_definitions(${name} PRIVATE EXPECTED_MAJOR=${major} EXPECTED_MINOR=${minor}
    EXPECTED_PATCH=${patch} EXPECTED_STRING="${major}.${minor}.${patch}")
  add_test(NAME ${name} COMMAND ${name})
endfunction()

xmpl100_version_test(xmpl100_version "" ${PROJECT_VERSION_MAJOR} ${PROJECT_VERSION_MINOR}
  ${PROJECT_VERSION_PATCH})

function(xmpl100_version_probe_header)
  set(XMPL100_VERSION_MAJOR 9)
  set(XMPL100_VERSION_MINOR 8)
  set(XMPL100_VERSION_PATCH 7)
  set(XMPL100_VERSION 9.8.7)
  configure_file(${XMPL100_VERSION_TEMPLATE} ${CMAKE_CURRENT_BINARY_DIR}/version_probe/@ROOT@/Version.h @ONLY)
endfunction()
xmpl100_version_probe_header()
xmpl100_version_test(xmpl100_version_probe ${CMAKE_CURRENT_BINARY_DIR}/version_probe 9 8 7)

foreach(copy "_config/Doxyfile|PROJECT_NUMBER")
  string(REPLACE "|" ";" parts "${copy}")
  list(GET parts 0 file)
  list(GET parts 1 key)
  string(MAKE_C_IDENTIFIER "${file}" id)
  add_test(NAME xmpl100_version_copy_${id}
    COMMAND ${CMAKE_COMMAND} -DFILE=${PROJECT_SOURCE_DIR}/${file} -DKEY=${key} -DVERSION=${PROJECT_VERSION}
            -P ${CMAKE_CURRENT_SOURCE_DIR}/check_version_copy.cmake)
endforeach()

