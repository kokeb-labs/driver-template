// --8<-- [start:quickstart]
#include "@ROOT@/MovingAverage.h"

int smooth(const float* samples, int n, float& mean) {
  xmpl100::MovingAverage<16> avg(xmpl100::Config{8, 0.0F}); // 16 samples of storage, window 8

  if (auto r = avg.EnsureInitialized(); !r) { // 1. window checked, samples cleared
    return static_cast<int>(r.error);
  }
  for (int i = 0; i < n; ++i) {
    if (auto r = avg.Push(samples[i]); !r) { // 2. NaN is refused
      return static_cast<int>(r.error);
    }
  }
  const auto m = avg.Average(); // 3. Empty when n == 0
  if (!m) {
    return static_cast<int>(m.error);
  }
  mean = m.value;
  return 0;
}
// --8<-- [end:quickstart]
