/**
 * @file main.cpp
 * @brief @TITLE@ on your PC: smooth a series of samples with MovingAverage and print the mean.
 *
 * No hardware and no SDK; the same calls run on any MCU. Exit code 0 when every call succeeded.
 */
#include <cstdio>

#include "@ROOT@/MovingAverage.h"

int main() {
  xmpl100::MovingAverage<16> avg(xmpl100::Config{4, 0.0F}); // 16 samples of storage, no heap

  std::printf("@TITLE@ %s on the host\n", xmpl100::GetVersion());
  if (const auto r = avg.EnsureInitialized(); !r) {
    std::printf("EnsureInitialized failed: %s\n", xmpl100::ToString(r.error));
    return 1;
  }
  const float samples[] = {24.0F, 25.0F, 26.0F, 25.0F, 30.0F};
  for (const float s : samples) {
    if (const auto r = avg.Push(s); !r) {
      std::printf("Push failed: %s\n", xmpl100::ToString(r.error));
      return 1;
    }
    const auto m = avg.Average();
    if (!m) {
      std::printf("Average failed: %s\n", xmpl100::ToString(m.error));
      return 1;
    }
    std::printf("sample %.2f, average %.2f\n", static_cast<double>(s),
                static_cast<double>(m.value));
  }
  return 0;
}
