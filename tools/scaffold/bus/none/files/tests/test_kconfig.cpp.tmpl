/**
 * @file test_kconfig.cpp
 * @brief KconfigDefaults(): Config{} without Kconfig, the menuconfig values with it (KCONFIG_SET).
 */
#include "test_harness.hpp"
#include "xmpl100_kconfig.hpp"

#if defined(KCONFIG_SET)
TEST_CASE("Kconfig values reach the Config") {
  constexpr xmpl100::Config c = xmpl100::KconfigDefaults();
  CHECK_EQ(c.samples, 8);
  CHECK_EQ(c.sample_interval_us, 2000U);
}
#else
TEST_CASE("Without Kconfig, KconfigDefaults() equals Config{}") {
  constexpr xmpl100::Config c = xmpl100::KconfigDefaults();
  CHECK_EQ(c.samples, xmpl100::Config{}.samples);
  CHECK_EQ(c.sample_interval_us, xmpl100::Config{}.sample_interval_us);
}
#endif
