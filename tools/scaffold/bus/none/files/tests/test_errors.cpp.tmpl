/**
 * @file test_errors.cpp
 * @brief The `Error` enum follows the standard, and its values are returned by real calls.
 *
 * Base values (0 to 9) MAY go unreturned: this GPIO-only driver never returns `Timeout`, `Crc` or
 * `Busy`, and its API guide says so. Every chip-specific value (16 and up) MUST be returned by some
 * call.
 */
#include <cstring>

#include "mock_xmpl100.hpp"
#include "test_harness.hpp"
#include "xmpl100.hpp"

using xmpl100::Error;
using xmpl100_test::FullPort;
using xmpl100_test::MinimalPort;

static_assert(static_cast<int>(Error::Ok) == 0 && static_cast<int>(Error::Bus) == 3 &&
                  static_cast<int>(Error::DeviceIdMismatch) == 5 &&
                  static_cast<int>(Error::Unsupported) == 9,
              "the base Error set has fixed values (standards/driver.md)");

namespace {

constexpr bool kRequireEveryBaseValue = false;
constexpr int kFirstChipSpecific = 16;
bool g_seen[256] = {};

void Record(Error e) {
  g_seen[static_cast<uint8_t>(e)] = true;
}

void RunScenarios() {
  {
    MinimalPort port;
    xmpl100::XMPL100<MinimalPort> s(port);
    Record(s.ReadOutput().error); // NotInitialized
    xmpl100::Config c{};
    c.samples = 0;
    Record(s.Initialize(c).error); // InvalidArgument
    Record(s.Initialize().error);  // Ok
    Record(s.Sleep().error);       // Unsupported
    port.state.unstable = true;
    Record(s.ReadOutput().error); // DeviceFault
  }
  {
    MinimalPort port;
    port.state.bus_up_ok = false;
    xmpl100::XMPL100<MinimalPort> s(port);
    Record(s.Initialize().error); // Bus
  }
  {
    FullPort port;
    port.state.present = false;
    xmpl100::XMPL100<FullPort> s(port);
    Record(s.Initialize().error); // DeviceIdMismatch
  }
}

} // namespace

TEST_CASE("Every chip-specific Error value is returned by some call") {
  RunScenarios();
  for (int v = 0; v < 256; ++v) {
    const auto e = static_cast<Error>(v);
    if (std::strcmp(xmpl100::ToString(e), "Unknown") == 0) {
      continue;
    }
    const bool required = v >= kFirstChipSpecific || kRequireEveryBaseValue;
    if (!g_seen[v]) {
      std::printf("    %s: Error::%s is never returned\n", required ? "FAIL" : "note",
                  xmpl100::ToString(e));
    }
    CHECK(g_seen[v] || !required);
    CHECK(v < 10 || v >= kFirstChipSpecific);
  }
}
