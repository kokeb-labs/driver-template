/**
 * @file test_xmpl100.cpp
 * @brief Driver behaviour over the pin model: lifecycle, the self-test check, sampling, hooks.
 */
#include "mock_xmpl100.hpp"
#include "test_harness.hpp"
#include "xmpl100.hpp"

using xmpl100::Error;
using xmpl100::GpioSignal;
using xmpl100_test::FullPort;
using xmpl100_test::MinimalPort;

TEST_CASE("The constructor does no I/O, and every read returns NotInitialized before Initialize") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  CHECK_EQ(port.state.transfers, 0);
  CHECK_EQ(sw.ReadOutput().error, Error::NotInitialized);
  CHECK_EQ(sw.IsOverTemperature().error, Error::NotInitialized);
  CHECK_EQ(sw.Sleep().error, Error::NotInitialized);
  CHECK_EQ(port.state.transfers, 0);
}

TEST_CASE("Without GpioSet, Initialize waits out the self-test pulse and reads nothing") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  REQUIRE(sw.Initialize().ok());
  CHECK(port.delayed_us >= xmpl100::kSelfTestTimeMaxUs);
  CHECK_EQ(port.state.transfers, 0);
  CHECK(sw.IsInitialized());
}

TEST_CASE("With GpioSet, Initialize power-cycles the part and checks the self-test pulse") {
  FullPort port;
  xmpl100::XMPL100<FullPort> sw(port);
  REQUIRE(sw.Initialize().ok());
  CHECK(port.state.powered);
  CHECK(port.delayed_us >= xmpl100::kSelfTestTimeMaxUs);
  CHECK_EQ(port.state.transfers, 1);
  const auto over = sw.IsOverTemperature(); // the pulse is over: OUT follows the temperature
  REQUIRE(over.ok());
  CHECK(!over.value);
}

TEST_CASE("No self-test pulse is DeviceIdMismatch") {
  FullPort port;
  port.state.present = false;
  xmpl100::XMPL100<FullPort> sw(port);
  CHECK_EQ(sw.Initialize().error, Error::DeviceIdMismatch);
  CHECK(!sw.IsInitialized());
}

TEST_CASE("A failing port is Bus, on bring-up, on SHDN_N and on every read") {
  FullPort port;
  port.state.bus_up_ok = false;
  xmpl100::XMPL100<FullPort> sw(port);
  CHECK_EQ(sw.Initialize().error, Error::Bus);
  port.state.bus_up_ok = true;
  port.gpio_ok = false;
  CHECK_EQ(sw.Initialize().error, Error::Bus);
  port.gpio_ok = true;
  port.state.fail_transfer = port.state.transfers;
  CHECK_EQ(sw.Initialize().error, Error::Bus);
  REQUIRE(sw.Initialize().ok());
  port.state.fail_transfer = port.state.transfers + 2;
  CHECK_EQ(sw.IsOverTemperature().error, Error::Bus);
}

TEST_CASE("IsOverTemperature follows the trip point and samples Config::samples times") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  REQUIRE(sw.Initialize(xmpl100::DebouncedPreset()).ok());
  port.state.temperature_c = 90.0F;
  const int before = port.state.transfers;
  const auto over = sw.IsOverTemperature();
  REQUIRE(over.ok());
  CHECK(over.value);
  CHECK_EQ(port.state.transfers - before, 8);
  port.state.temperature_c = 40.0F;
  const auto out = sw.ReadOutput();
  REQUIRE(out.ok());
  CHECK(out.value == GpioSignal::INACTIVE);
}

TEST_CASE("An unstable OUT is DeviceFault; one sample cannot see it") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  REQUIRE(sw.Initialize().ok());
  port.state.unstable = true;
  CHECK_EQ(sw.ReadOutput().error, Error::DeviceFault);
  REQUIRE(sw.Initialize(xmpl100::FastPreset()).ok());
  CHECK(sw.ReadOutput().ok());
}

TEST_CASE("Validate rejects bad configurations before any I/O") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  xmpl100::Config c{};
  c.samples = 0;
  CHECK_EQ(sw.Initialize(c).error, Error::InvalidArgument);
  c = xmpl100::Config{};
  c.sample_interval_us = xmpl100::kMaxSampleIntervalUs + 1;
  CHECK_EQ(sw.Initialize(c).error, Error::InvalidArgument);
  CHECK_EQ(port.state.bus_up_calls, 0);
  CHECK_EQ(xmpl100::Validate(xmpl100::FastPreset()), Error::Ok);
}

TEST_CASE("Sleep uses SHDN_N, and is Unsupported without GpioSet") {
  MinimalPort minimal;
  xmpl100::XMPL100<MinimalPort> a(minimal);
  REQUIRE(a.Initialize().ok());
  CHECK_EQ(a.Sleep().error, Error::Unsupported);

  FullPort full;
  xmpl100::XMPL100<FullPort> b(full);
  REQUIRE(b.Initialize().ok());
  REQUIRE(b.Sleep().ok());
  CHECK(!full.state.powered);
  CHECK(!b.IsInitialized());
  REQUIRE(b.EnsureInitialized().ok());
  CHECK(full.state.powered);
}

TEST_CASE("Deinitialize is idempotent") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  CHECK(sw.Deinitialize().ok());
  REQUIRE(sw.Initialize().ok());
  CHECK(sw.Deinitialize().ok());
  CHECK_EQ(sw.ReadOutput().error, Error::NotInitialized);
}
