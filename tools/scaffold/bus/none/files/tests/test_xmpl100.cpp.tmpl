/**
 * @file test_xmpl100.cpp
 * @brief Driver behaviour over the pin model: lifecycle, the self-test check, sampling, hooks.
 */
#include "mock_xmpl100.hpp"
#include "test_harness.hpp"
#include "xmpl100.hpp"

using xmpl100::Error;
using xmpl100::GpioSignal;
using xmpl100_test::FullPort;
using xmpl100_test::MinimalPort;

TEST_CASE("The constructor does no I/O, and every read returns NotInitialized before the start") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  CHECK_EQ(port.state.transfers, 0);
  CHECK_EQ(sw.ReadOutput().error, Error::NotInitialized);
  CHECK_EQ(sw.IsOverTemperature().error, Error::NotInitialized);
  CHECK_EQ(sw.Sleep().error, Error::NotInitialized);
  CHECK_EQ(port.state.transfers, 0);
  CHECK_EQ(port.state.bus_up_calls, 0); // no read starts the part as a side effect
  CHECK(!sw.IsInitialized());
}

TEST_CASE("EnsureInitialized starts the part once, then returns Ok with no I/O") {
  FullPort port;
  xmpl100::XMPL100<FullPort> sw(port);
  REQUIRE(sw.EnsureInitialized().ok());
  const int transfers = port.state.transfers;
  const int bus_up_calls = port.state.bus_up_calls;
  const uint64_t delayed_us = port.delayed_us;
  for (int i = 0; i < 3; ++i) {
    CHECK(sw.EnsureInitialized().ok());
  }
  CHECK_EQ(port.state.transfers, transfers);
  CHECK_EQ(port.state.bus_up_calls, bus_up_calls);
  CHECK(port.delayed_us == delayed_us);
}

TEST_CASE("After a failed start, EnsureInitialized starts again; Deinitialize restarts it") {
  FullPort port;
  port.state.present = false;
  xmpl100::XMPL100<FullPort> sw(port);
  CHECK_EQ(sw.EnsureInitialized().error, Error::DeviceIdMismatch);
  CHECK(!sw.IsInitialized());
  const int failed = port.state.transfers;
  CHECK_EQ(sw.ReadOutput().error, Error::NotInitialized);
  CHECK_EQ(port.state.transfers, failed);
  port.state.present = true;
  REQUIRE(sw.EnsureInitialized().ok()); // the self-test pulse is checked again
  CHECK_EQ(port.state.transfers, failed + 1);
  REQUIRE(sw.Deinitialize().ok());
  CHECK(!port.state.powered);
  REQUIRE(sw.EnsureInitialized().ok());
  CHECK(port.state.powered);
  CHECK_EQ(port.state.transfers, failed + 2);
}

TEST_CASE("Without GpioSet, EnsureInitialized waits out the self-test pulse and reads nothing") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  REQUIRE(sw.EnsureInitialized().ok());
  CHECK(port.delayed_us >= xmpl100::kSelfTestTimeMaxUs);
  CHECK_EQ(port.state.transfers, 0);
  CHECK(sw.IsInitialized());
}

TEST_CASE("With GpioSet, EnsureInitialized power-cycles the part and checks the self-test pulse") {
  FullPort port;
  xmpl100::XMPL100<FullPort> sw(port);
  REQUIRE(sw.EnsureInitialized().ok());
  CHECK(port.state.powered);
  CHECK(port.delayed_us >= xmpl100::kSelfTestTimeMaxUs);
  CHECK_EQ(port.state.transfers, 1);
  const auto over = sw.IsOverTemperature(); // the pulse is over: OUT follows the temperature
  REQUIRE(over.ok());
  CHECK(!over.value);
}

TEST_CASE("No self-test pulse is DeviceIdMismatch") {
  FullPort port;
  port.state.present = false;
  xmpl100::XMPL100<FullPort> sw(port);
  CHECK_EQ(sw.EnsureInitialized().error, Error::DeviceIdMismatch);
  CHECK(!sw.IsInitialized());
}

TEST_CASE("A failing port is Bus, on bring-up, on SHDN_N and on every read") {
  FullPort port;
  port.state.bus_up_ok = false;
  xmpl100::XMPL100<FullPort> sw(port);
  CHECK_EQ(sw.EnsureInitialized().error, Error::Bus);
  port.state.bus_up_ok = true;
  port.gpio_ok = false;
  CHECK_EQ(sw.EnsureInitialized().error, Error::Bus);
  port.gpio_ok = true;
  port.state.fail_transfer = port.state.transfers;
  CHECK_EQ(sw.EnsureInitialized().error, Error::Bus);
  REQUIRE(sw.EnsureInitialized().ok());
  port.state.fail_transfer = port.state.transfers + 2;
  CHECK_EQ(sw.IsOverTemperature().error, Error::Bus);
}

TEST_CASE("IsOverTemperature follows the trip point and samples Config::samples times") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port, xmpl100::DebouncedPreset());
  REQUIRE(sw.EnsureInitialized().ok());
  port.state.temperature_c = 90.0F;
  const int before = port.state.transfers;
  const auto over = sw.IsOverTemperature();
  REQUIRE(over.ok());
  CHECK(over.value);
  CHECK_EQ(port.state.transfers - before, 8);
  port.state.temperature_c = 40.0F;
  const auto out = sw.ReadOutput();
  REQUIRE(out.ok());
  CHECK(out.value == GpioSignal::INACTIVE);
}

TEST_CASE("An unstable OUT is DeviceFault; one sample cannot see it") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  REQUIRE(sw.EnsureInitialized().ok());
  port.state.unstable = true;
  CHECK_EQ(sw.ReadOutput().error, Error::DeviceFault);
  xmpl100::XMPL100<MinimalPort> fast(port, xmpl100::FastPreset());
  REQUIRE(fast.EnsureInitialized().ok());
  CHECK(fast.ReadOutput().ok());
}

TEST_CASE("Validate rejects bad configurations before any I/O") {
  MinimalPort port;
  xmpl100::Config c{};
  c.samples = 0;
  xmpl100::XMPL100<MinimalPort> sw(port, c);
  CHECK_EQ(sw.EnsureInitialized().error, Error::InvalidArgument);
  c = xmpl100::Config{};
  c.sample_interval_us = xmpl100::kMaxSampleIntervalUs + 1;
  xmpl100::XMPL100<MinimalPort> slow(port, c);
  CHECK_EQ(slow.EnsureInitialized().error, Error::InvalidArgument);
  CHECK_EQ(port.state.bus_up_calls, 0);
  CHECK_EQ(xmpl100::Validate(xmpl100::FastPreset()), Error::Ok);
}

TEST_CASE("Sleep uses SHDN_N, and is Unsupported without GpioSet") {
  MinimalPort minimal;
  xmpl100::XMPL100<MinimalPort> a(minimal);
  REQUIRE(a.EnsureInitialized().ok());
  CHECK_EQ(a.Sleep().error, Error::Unsupported);

  FullPort full;
  xmpl100::XMPL100<FullPort> b(full);
  REQUIRE(b.EnsureInitialized().ok());
  REQUIRE(b.Sleep().ok());
  CHECK(!full.state.powered);
  CHECK(!b.IsInitialized());
  REQUIRE(b.EnsureInitialized().ok());
  CHECK(full.state.powered);
}

TEST_CASE("Deinitialize is idempotent") {
  MinimalPort port;
  xmpl100::XMPL100<MinimalPort> sw(port);
  CHECK(sw.Deinitialize().ok());
  REQUIRE(sw.EnsureInitialized().ok());
  CHECK(sw.Deinitialize().ok());
  CHECK_EQ(sw.ReadOutput().error, Error::NotInitialized);
}
