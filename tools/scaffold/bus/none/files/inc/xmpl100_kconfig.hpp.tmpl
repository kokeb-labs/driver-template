/**
 * @file xmpl100_kconfig.hpp
 * @brief Optional ESP-IDF layer: a `Config` built from the `CONFIG_XMPL100_*` Kconfig options.
 * @copyright Copyright (c) 2026 The driver-template authors. SPDX-License-Identifier: MIT
 *
 * Include it only where menuconfig should choose the defaults; without Kconfig `KconfigDefaults()`
 * equals `Config{}`. One configuration per program: every translation unit of one program must see
 * the same `CONFIG_` values, and no driver header includes this one (handbook KB-CPP20-018).
 */
#ifndef XMPL100_KCONFIG_HPP
#define XMPL100_KCONFIG_HPP

#ifdef __has_include
#if __has_include("sdkconfig.h")
#include "sdkconfig.h"
#endif
#endif

#include "xmpl100_types.hpp"

#ifndef CONFIG_XMPL100_SAMPLES
/** Reads of OUT per reading when Kconfig does not set it: `Config{}.samples`. */
#define CONFIG_XMPL100_SAMPLES 3
#endif
#ifndef CONFIG_XMPL100_SAMPLE_INTERVAL_US
/** Wait between two reads when Kconfig does not set it: `Config{}.sample_interval_us`. */
#define CONFIG_XMPL100_SAMPLE_INTERVAL_US 1000
#endif

namespace xmpl100 {

/**
 * @brief The configuration menuconfig selected, on top of the datasheet defaults.
 * @return `Config{}` with the sampling from Kconfig.
 */
constexpr Config KconfigDefaults() noexcept {
  Config c{};
  c.samples = static_cast<uint16_t>(CONFIG_XMPL100_SAMPLES);
  c.sample_interval_us = static_cast<uint32_t>(CONFIG_XMPL100_SAMPLE_INTERVAL_US);
  return c;
}

} // namespace xmpl100

#endif // XMPL100_KCONFIG_HPP
