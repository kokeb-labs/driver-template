/**
 * @file esp32_xmpl100_port.hpp
 * @brief ESP-IDF port for the XMPL100 driver: i2c_master for the bus, GPIO for RESET_N, esp_rom
 * delays and ESP_LOG for the log hook.
 *
 * Start from this file for any ESP-IDF target. The pins are in Esp32Xmpl100Pins; the defaults match
 * the wiring table in examples/esp32/README.md (ESP32-C6 DevKitC-1).
 */
#pragma once

#include <cstdarg>
#include <cstddef>
#include <cstdint>

#include "driver/gpio.h"
#include "driver/i2c_master.h"
#include "esp_log.h"
#include "esp_rom_sys.h"

#include "xmpl100.hpp"

/// Pins and bus settings of the ESP-IDF port.
struct Esp32Xmpl100Pins {
  i2c_port_num_t port = I2C_NUM_0;
  int sda = 6;
  int scl = 7;
  int reset_n = 11; ///< -1 when RESET_N is tied high.
  uint32_t clock_hz = 100000;
  int timeout_ms = 10; ///< Per transaction.
};

/// The XMPL100 I2C port on ESP-IDF, with every optional hook.
class Esp32Xmpl100Port : public xmpl100::SpiInterface<Esp32Xmpl100Port> {
public:
  explicit Esp32Xmpl100Port(const Esp32Xmpl100Pins& pins = {}) noexcept : pins_(pins) {}

  bool EnsureInitialized() noexcept {
    if (bus_ != nullptr) {
      return true;
    }
    i2c_master_bus_config_t bus{};
    bus.i2c_port = pins_.port;
    bus.sda_io_num = static_cast<gpio_num_t>(pins_.sda);
    bus.scl_io_num = static_cast<gpio_num_t>(pins_.scl);
    bus.clk_source = I2C_CLK_SRC_DEFAULT;
    bus.glitch_ignore_cnt = 7;
    bus.flags.enable_internal_pullup = true;
    if (i2c_new_master_bus(&bus, &bus_) != ESP_OK) {
      bus_ = nullptr;
      return false;
    }
    if (pins_.reset_n >= 0) {
      gpio_config_t io{};
      io.pin_bit_mask = 1ULL << static_cast<unsigned>(pins_.reset_n);
      io.mode = GPIO_MODE_OUTPUT;
      if (gpio_config(&io) != ESP_OK ||
          gpio_set_level(static_cast<gpio_num_t>(pins_.reset_n), 1) != ESP_OK) {
        return false;
      }
    }
    return true;
  }

  bool Write(uint8_t addr, const uint8_t* data, std::size_t len) noexcept {
    i2c_master_dev_handle_t dev = device(addr);
    return dev != nullptr && i2c_master_transmit(dev, data, len, pins_.timeout_ms) == ESP_OK;
  }

  bool WriteRead(uint8_t addr, const uint8_t* tx, std::size_t tx_len, uint8_t* rx,
                 std::size_t rx_len) noexcept {
    i2c_master_dev_handle_t dev = device(addr);
    return dev != nullptr &&
           i2c_master_transmit_receive(dev, tx, tx_len, rx, rx_len, pins_.timeout_ms) == ESP_OK;
  }

  void DelayUs(uint32_t us) noexcept {
    esp_rom_delay_us(us);
  }

  bool GpioSet(xmpl100::CtrlPin pin, xmpl100::GpioSignal signal) noexcept {
    if (pin != xmpl100::CtrlPin::Reset || pins_.reset_n < 0) {
      return false;
    }
    const uint32_t level = signal == xmpl100::GpioSignal::ACTIVE ? 0 : 1; // RESET_N is active low
    return gpio_set_level(static_cast<gpio_num_t>(pins_.reset_n), level) == ESP_OK;
  }

  void Log(xmpl100::LogLevel level, const char* fmt, ...) noexcept {
    const esp_log_level_t esp_level = level == xmpl100::LogLevel::Error     ? ESP_LOG_ERROR
                                      : level == xmpl100::LogLevel::Warning ? ESP_LOG_WARN
                                      : level == xmpl100::LogLevel::Info    ? ESP_LOG_INFO
                                                                            : ESP_LOG_DEBUG;
    va_list args;
    va_start(args, fmt);
    esp_log_writev(esp_level, kTag, fmt, args);
    va_end(args);
    esp_log_write(esp_level, kTag, "\n");
  }

private:
  // The device handle for one 7-bit address, created on first use (one chip per port in this
  // example).
  i2c_master_dev_handle_t device(uint8_t addr) noexcept {
    if (device_ != nullptr && device_addr_ == addr) {
      return device_;
    }
    if (device_ != nullptr) {
      i2c_master_bus_rm_device(device_);
      device_ = nullptr;
    }
    i2c_device_config_t cfg{};
    cfg.dev_addr_length = I2C_ADDR_BIT_LEN_7;
    cfg.device_address = addr;
    cfg.scl_speed_hz = pins_.clock_hz;
    if (i2c_master_bus_add_device(bus_, &cfg, &device_) != ESP_OK) {
      device_ = nullptr;
      return nullptr;
    }
    device_addr_ = addr;
    return device_;
  }

  static constexpr const char* kTag = "xmpl100";
  Esp32Xmpl100Pins pins_;
  i2c_master_bus_handle_t bus_ = nullptr;
  i2c_master_dev_handle_t device_ = nullptr;
  uint8_t device_addr_ = 0;
};
