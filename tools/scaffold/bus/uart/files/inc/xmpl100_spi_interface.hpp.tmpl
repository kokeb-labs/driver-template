/**
 * @file xmpl100_spi_interface.hpp
 * @brief The UART port of the XMPL100 driver: the CRTP base, its pin enums, the `SpiPort` concept
 * and the register framing.
 * @copyright Copyright (c) 2026 The Kokeb Labs Authors. SPDX-License-Identifier: MIT
 *
 * @details
 * The driver never calls an SDK. It calls hooks on a class you derive from
 * `xmpl100::SpiInterface<Self>`:
 *
 * | Hook | Contract |
 * | --- | --- |
 * | `bool EnsureInitialized() noexcept` | Bring the UART up on the first call; `true` at once afterwards |
 * | `bool Write(const uint8_t* data, std::size_t len) noexcept` | Send `len` bytes; `false` on an error |
 * | `bool Read(uint8_t* data, std::size_t len, uint32_t timeout_ms) noexcept` | Receive exactly `len` bytes within `timeout_ms`, or `false` |
 * | `bool FlushInput() noexcept` | Drop every received byte not read yet |
 *
 * 115200 baud, 8 data bits, no parity, 1 stop bit (datasheet section 6.3). The port moves raw
 * bytes; the driver builds and checks the frames.
 */
// clang-format on
#pragma once

#include <array>
#include <concepts>
#include <cstddef>
#include <cstdint>

#include "xmpl100_registers.hpp"
#include "xmpl100_types.hpp"

namespace xmpl100 {

/** @brief Control pins the port may drive through the optional `GpioSet()` hook. */
enum class CtrlPin : uint8_t {
  Reset = 0, ///< RESET_N, active low on the package pin. ACTIVE holds the chip in reset.
};

/** @brief Logical level of a control pin; the port maps it to the physical polarity. */
enum class GpioSignal : uint8_t {
  INACTIVE = 0, ///< The pin function is deasserted.
  ACTIVE = 1,   ///< The pin function is asserted.
};

/**
 * @brief CRTP base of the platform UART port.
 *
 * Derive `class MyPort : public xmpl100::SpiInterface<MyPort>` and implement the hooks in this
 * file's description. The base declares no hook itself (a forwarding hook would turn a missing
 * override into infinite recursion) and no data; the driver checks your class with the `SpiPort`
 * concept, so a missing or misdeclared hook is a compile error that names it.
 *
 * @tparam Derived Your port class.
 */
template <typename Derived>
class SpiInterface {
public:
  /** @brief Ports are not copied: the driver holds a reference. */
  SpiInterface(const SpiInterface&) = delete;
  /** @brief Ports are not copied: the driver holds a reference. */
  SpiInterface& operator=(const SpiInterface&) = delete;

protected:
  /** @brief Only the derived port is constructed. */
  SpiInterface() noexcept = default;
  /** @brief Destroyed through the derived port only. */
  ~SpiInterface() noexcept = default;
};

/**
 * @brief Satisfied by a class that derives from `SpiInterface<Port>` and implements the required
 * hooks with the right types.
 * @tparam Port The port class.
 */
template <typename Port>
concept SpiPort =
    std::derived_from<Port, SpiInterface<Port>> &&
    requires(Port& port, const uint8_t* tx, uint8_t* rx, std::size_t len, uint32_t ms) {
      { port.EnsureInitialized() } -> std::same_as<bool>;
      { port.Write(tx, len) } -> std::same_as<bool>;
      { port.Read(rx, len, ms) } -> std::same_as<bool>;
      { port.FlushInput() } -> std::same_as<bool>;
    };

namespace detail {

/// Longest register burst the driver issues, in data bytes.
inline constexpr std::size_t kMaxBurst = 4;
/// First byte of every frame in both directions (datasheet 6.3.1).
inline constexpr uint8_t kSync = 0xA5;
/// Command flag of a read request.
inline constexpr uint8_t kReadFlag = 0x80;
/// Reply to an accepted write.
inline constexpr uint8_t kAck = 0x06;
/// Longest reply time of the chip, in milliseconds (datasheet t_REPLY).
inline constexpr uint32_t kReplyTimeoutMs = 5;

/**
 * Register access over UART (datasheet 6.3): a request `[0xA5, cmd, len, data..., crc]` with
 * `cmd = 0x80 | reg` for a read; a read reply `[0xA5, data..., crc]`, a write reply `[0xA5, 0x06]`.
 * The CRC-8 (`reg::Crc8`) covers everything after the sync byte.
 */
template <SpiPort Port>
class RegisterBus {
public:
  explicit RegisterBus(Port& port) noexcept : port_(port) {}

  Port& GetPort() noexcept {
    return port_;
  }

  /// Read `len` registers from `reg`. `Bus` on a write error or bad sync, `Timeout` without a
  /// reply, `Crc` on a corrupted reply.
  Error Read(uint8_t reg, uint8_t* out, std::size_t len) noexcept {
    if (len == 0 || len > kMaxBurst) {
      return Error::InvalidArgument;
    }
    if (const Error e = request(static_cast<uint8_t>(kReadFlag | reg), nullptr, len);
        e != Error::Ok) {
      return e;
    }
    std::array<uint8_t, 1 + kMaxBurst + 1> reply{};
    if (!port_.Read(reply.data(), len + 2, kReplyTimeoutMs)) {
      return Error::Timeout;
    }
    if (reply[0] != kSync) {
      return Error::Bus;
    }
    if (reg::Crc8(reply.data() + 1, len) != reply[1 + len]) {
      return Error::Crc;
    }
    for (std::size_t i = 0; i < len; ++i) {
      out[i] = reply[1 + i];
    }
    return Error::Ok;
  }

  /// Write `len` registers from `reg`; the chip acknowledges each request.
  Error Write(uint8_t reg, const uint8_t* data, std::size_t len) noexcept {
    if (len == 0 || len > kMaxBurst) {
      return Error::InvalidArgument;
    }
    if (const Error e = request(reg, data, len); e != Error::Ok) {
      return e;
    }
    std::array<uint8_t, 2> reply{};
    if (!port_.Read(reply.data(), reply.size(), kReplyTimeoutMs)) {
      return Error::Timeout;
    }
    return reply[0] == kSync && reply[1] == kAck ? Error::Ok : Error::Bus;
  }

private:
  Error request(uint8_t cmd, const uint8_t* data, std::size_t len) noexcept {
    std::array<uint8_t, 3 + kMaxBurst + 1> frame{kSync, cmd, static_cast<uint8_t>(len)};
    std::size_t n = 3;
    for (std::size_t i = 0; data != nullptr && i < len; ++i) {
      frame[n++] = data[i];
    }
    frame[n] = reg::Crc8(frame.data() + 1, n - 1);
    ++n;
    if (!port_.FlushInput() || !port_.Write(frame.data(), n)) {
      return Error::Bus;
    }
    return Error::Ok;
  }

  Port& port_;
};

} // namespace detail

} // namespace xmpl100
