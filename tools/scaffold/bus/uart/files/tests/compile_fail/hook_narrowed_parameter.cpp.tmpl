/**
 * @file hook_narrowed_parameter.cpp
 * @brief Must NOT compile: a Read hook with a narrower length would truncate replies, so the port concept rejects it (handbook KB-CPP20-006).
 *
 * EXPECT: SpiPort
 */
#include <cstddef>
#include <cstdint>

#include "xmpl100.hpp"

class NarrowPort : public xmpl100::SpiInterface<NarrowPort> {
public:
  bool EnsureInitialized() noexcept {
    return true;
  }
  bool Write(const uint8_t* data, std::size_t len) noexcept {
    (void)data;
    return len > 0U;
  }
  bool Read(uint8_t* data, uint8_t len, uint32_t timeout_ms) noexcept {
    (void)data;
    (void)timeout_ms;
    return len > 0U;
  }
  bool FlushInput() noexcept {
    return true;
  }
  void DelayUs(uint32_t us) noexcept {
    (void)us;
  }
};

int main() {
  NarrowPort port;
  xmpl100::XMPL100<NarrowPort> sensor(port);
  return static_cast<int>(sensor.EnsureInitialized().error);
}
