/**
 * @file hook_not_noexcept.cpp
 * @brief Must NOT compile: a Read hook that is not noexcept breaks the port contract, so the port concept rejects it (handbook KB-CPP20-006).
 *
 * EXPECT: SpiPort
 */
#include <cstddef>
#include <cstdint>

#include "xmpl100.hpp"

class ThrowingPort : public xmpl100::SpiInterface<ThrowingPort> {
public:
  bool EnsureInitialized() noexcept {
    return true;
  }
  bool Write(const uint8_t* data, std::size_t len) noexcept {
    (void)data;
    return len > 0U;
  }
  bool Read(uint8_t* data, std::size_t len, uint32_t timeout_ms) {
    (void)data;
    (void)timeout_ms;
    return len > 0U;
  }
  bool FlushInput() noexcept {
    return true;
  }
  void DelayUs(uint32_t us) noexcept {
    (void)us;
  }
};

int main() {
  ThrowingPort port;
  xmpl100::XMPL100<ThrowingPort> sensor(port);
  return static_cast<int>(sensor.EnsureInitialized().error);
}
