/**
 * @file main.cpp
 * @brief Builds the driver from the installed package only: headers, version header and .ipp.
 */
#include <cstddef>
#include <cstdint>

#include "xmpl100.hpp"

namespace {

// A port that never receives a byte: enough to instantiate the whole driver template.
class SilentPort : public xmpl100::SpiInterface<SilentPort> {
public:
  bool EnsureInitialized() noexcept {
    return true;
  }
  bool Write(const uint8_t* data, std::size_t len) noexcept {
    (void)data;
    (void)len;
    return true;
  }
  bool Read(uint8_t* data, std::size_t len, uint32_t timeout_ms) noexcept {
    (void)data;
    (void)len;
    (void)timeout_ms;
    return false;
  }
  bool FlushInput() noexcept {
    return true;
  }
  void DelayUs(uint32_t us) noexcept {
    (void)us;
  }
};

} // namespace

int main() {
  SilentPort port;
  xmpl100::XMPL100<SilentPort> sensor(port);
  // No reply ever arrives, so Initialize() must time out: proof the template compiled and ran.
  const auto r = sensor.Initialize();
  return (r.error == xmpl100::Error::Timeout && xmpl100::GetDriverVersion()[0] != '\0') ? 0 : 1;
}
