/**
 * @file mock_xmpl100_bus.hpp
 * @brief UART mock ports over the register model. The frame decoding here is the only bus-specific
 * part of the host tests.
 *
 * | Port | Hooks |
 * | --- | --- |
 * | `MinimalPort` | the required ones plus `DelayUs()` (needed by every wait) |
 * | `FullPort` | also `GpioSet()` (RESET_N) and `Log()` |
 */
#pragma once

#include <cstddef>
#include <cstdint>

#include "xmpl100_registers.hpp"
#include "xmpl100_spi_interface.hpp"
#include "xmpl100_types.hpp"

namespace xmpl100_test {

/// Shared state of the mock ports: the chip behind a UART, fault injection and counters.
struct MockBusState {
  Xmpl100Model chip;
  bool bus_up_ok = true;      ///< EnsureInitialized() result.
  int fail_transfer = -1;     ///< Fail the request with this index (0-based); -1 never.
  bool corrupt_reply = false; ///< Flip the CRC of every read reply.
  int transfers = 0;          ///< Requests so far.
  int bus_up_calls = 0;       ///< EnsureInitialized() calls so far.

  uint8_t reply[16] = {};
  std::size_t reply_len = 0;
  std::size_t reply_pos = 0;

  bool DoWrite(const uint8_t* data, std::size_t len) noexcept {
    const int index = transfers++;
    reply_len = reply_pos = 0;
    if (index == fail_transfer || len < 4 || data[0] != 0xA5) {
      return index != fail_transfer; // a malformed frame is ignored by the chip: no reply
    }
    const uint8_t cmd = data[1];
    const std::size_t n = data[2];
    const bool read = (cmd & 0x80U) != 0;
    const auto address = static_cast<uint8_t>(cmd & 0x7FU);
    const std::size_t frame_len = read ? 4 : 4 + n;
    if (len != frame_len || xmpl100::reg::Crc8(data + 1, frame_len - 2) != data[frame_len - 1]) {
      return true; // bad CRC: the chip drops the frame
    }
    reply[reply_len++] = 0xA5;
    if (read) {
      for (std::size_t i = 0; i < n; ++i) {
        reply[reply_len++] = chip.Read(static_cast<uint8_t>(address + i));
      }
      uint8_t crc = xmpl100::reg::Crc8(reply + 1, n);
      reply[reply_len++] = corrupt_reply ? static_cast<uint8_t>(crc ^ 0xFF) : crc;
    } else {
      for (std::size_t i = 0; i < n; ++i) {
        chip.Write(static_cast<uint8_t>(address + i), data[3 + i]);
      }
      reply[reply_len++] = 0x06;
    }
    return true;
  }

  bool DoRead(uint8_t* data, std::size_t len) noexcept {
    if (reply_len - reply_pos < len) {
      return false; // timeout
    }
    for (std::size_t i = 0; i < len; ++i) {
      data[i] = reply[reply_pos++];
    }
    return true;
  }
};

/// The required UART hooks over a MockBusState. Derive `class P : public MockPortBase<P>`.
template <typename Self>
class MockPortBase : public xmpl100::SpiInterface<Self> {
public:
  MockBusState state;

  bool EnsureInitialized() noexcept {
    state.bus_up_calls++;
    return state.bus_up_ok;
  }
  bool Write(const uint8_t* data, std::size_t len) noexcept {
    return state.DoWrite(data, len);
  }
  bool Read(uint8_t* data, std::size_t len, uint32_t timeout_ms) noexcept {
    (void)timeout_ms;
    return state.DoRead(data, len);
  }
  bool FlushInput() noexcept {
    state.reply_len = state.reply_pos = 0;
    return true;
  }
};

/// Required hooks plus the delay; time passes in the model as the driver waits.
class MinimalPort : public MockPortBase<MinimalPort> {
public:
  uint64_t delayed_us = 0; ///< Sum of DelayUs() arguments.

  void DelayUs(uint32_t us) noexcept {
    delayed_us += us;
    state.chip.Elapse(us);
  }
};

/// Every optional hook, with counters.
class FullPort : public MockPortBase<FullPort> {
public:
  uint64_t delayed_us = 0; ///< Sum of DelayUs() arguments.
  int log_lines = 0;       ///< Log() calls.
  int error_lines = 0;     ///< Log() calls at LogLevel::Error.
  bool gpio_ok = true;     ///< GpioSet() result.
  bool reset_asserted = false;
  int reset_pulses = 0;

  void DelayUs(uint32_t us) noexcept {
    delayed_us += us;
    state.chip.Elapse(us);
  }
  bool GpioSet(xmpl100::CtrlPin pin, xmpl100::GpioSignal signal) noexcept {
    if (!gpio_ok || pin != xmpl100::CtrlPin::Reset) {
      return false;
    }
    const bool assert_reset = signal == xmpl100::GpioSignal::ACTIVE;
    if (reset_asserted && !assert_reset) {
      state.chip.Reset();
      reset_pulses++;
    }
    reset_asserted = assert_reset;
    return true;
  }
  void Log(xmpl100::LogLevel level, const char* fmt, ...) noexcept {
    (void)fmt;
    log_lines++;
    if (level == xmpl100::LogLevel::Error) {
      error_lines++;
    }
  }
};

} // namespace xmpl100_test
