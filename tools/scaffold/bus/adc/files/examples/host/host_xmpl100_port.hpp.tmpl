/**
 * @file host_xmpl100_port.hpp
 * @brief The host port: the driver's ADC hooks over a simulated XMPL100, so the example runs on any
 * PC.
 *
 * `xmpl100_test::MockPortBase` (tests/mock_xmpl100.hpp) supplies the required ADC hooks over the
 * sensor model the host tests use. This class adds what a real port adds: `DelayUs()` (here it
 * returns at once: the model converts instantly) and `Log()` to the console. A port for a real ADC
 * on a PC (a USB DAQ, an IIO device) implements the same hooks: see docs/porting.md.
 */
#pragma once

#include <cstdint>
#include <cstdio>

#include "mock_xmpl100.hpp"

/// The host port: simulated sensor, real console.
class HostXmpl100Port : public xmpl100_test::MockPortBase<HostXmpl100Port> {
public:
  /// The model needs no time; nothing sleeps.
  void DelayUs(uint32_t us) noexcept {
    (void)us;
  }

  /// Driver messages (they carry their own `xmpl100:` prefix) go to the console, one line each.
  void Log(xmpl100::LogLevel level, const char* message) noexcept {
    (void)level;
    (void)std::puts(message); // plain text: never pass it as a format string
  }
};
