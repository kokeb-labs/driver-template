/**
 * @file ports.cpp
 * @brief The port with every optional hook, as shown on the Porting page. Compiled, never run.
 */
#include <cstdarg>
#include <cstdint>

#include "xmpl100.hpp"

bool platform_adc_init() noexcept;
bool platform_adc_read_mv(uint8_t channel, uint32_t& mv) noexcept;
void platform_delay_us(uint32_t us) noexcept;
bool platform_gpio_write(int pin, bool high) noexcept;
void platform_vlog(const char* fmt, va_list args) noexcept;

// --8<-- [start:full-port]
class FullPort : public xmpl100::SpiInterface<FullPort> {
public:
  bool EnsureInitialized() noexcept {
    return platform_adc_init();
  }
  bool ReadVoltageMv(uint8_t channel, uint32_t& voltage_mv) noexcept {
    return platform_adc_read_mv(channel, voltage_mv);
  }
  void DelayUs(uint32_t us) noexcept {
    platform_delay_us(us);
  }

  // Optional: SHDN_N on a GPIO. ACTIVE means "powered", which is a high level on the pin.
  bool GpioSet(xmpl100::CtrlPin pin, xmpl100::GpioSignal signal) noexcept {
    if (pin != xmpl100::CtrlPin::Enable) {
      return false;
    }
    return platform_gpio_write(kShutdownGpio, signal == xmpl100::GpioSignal::ACTIVE);
  }

  // Optional: one line per failure. The driver never formats; the port does.
  void Log(xmpl100::LogLevel level, const char* fmt, ...) noexcept {
    (void)level;
    va_list args;
    va_start(args, fmt);
    platform_vlog(fmt, args);
    va_end(args);
  }

private:
  static constexpr int kShutdownGpio = 7;
};
// --8<-- [end:full-port]
