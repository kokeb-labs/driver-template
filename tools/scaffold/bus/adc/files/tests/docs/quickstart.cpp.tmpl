#include "my_port.hpp"

// --8<-- [start:quickstart]
#include "xmpl100.hpp"

int read_board_temperature(MyPort& port, float& celsius) {
  xmpl100::XMPL100<MyPort> sensor(port); // no I/O yet

  if (auto r = sensor.Initialize(); !r) { // 1. ADC up, t_ON, output in range
    return static_cast<int>(r.error);     //    DeviceIdMismatch: wrong channel or no sensor
  }
  const auto t = sensor.ReadTemperatureC(); // 2. 4 conversions averaged
  if (!t) {
    return static_cast<int>(t.error); //    DeviceFault: output open or shorted
  }
  celsius = t.value; // 3. degrees Celsius
  return 0;
}
// --8<-- [end:quickstart]
