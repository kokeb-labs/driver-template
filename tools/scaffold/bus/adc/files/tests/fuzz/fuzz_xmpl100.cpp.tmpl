/**
 * @file fuzz_xmpl100.cpp
 * @brief Fuzz target: the driver over an ADC whose readings the fuzzer controls.
 *
 * What the driver reads is a voltage from the port's ADC, so the reading is the untrusted input.
 * The fuzzer's bytes choose a configuration, then a sequence of driver calls; on every conversion
 * they also choose what the ADC does: pass the sensor model's output, fail, or return any voltage
 * (a floating input, a short, a wrong channel). They can also change the sensor between calls.
 *
 * After every call the target checks the driver's promises (docs/contract.md), and aborts, naming
 * the line, when one breaks:
 *
 * - a failed call returns an `Error` the enum defines and this driver returns (never `Timeout`,
 *   `Crc` or `Busy`), and `T{}`;
 * - before `EnsureInitialized()` succeeds, no call converts or drives a pin: reads return
 *   `NotInitialized`;
 * - `InvalidArgument` means nothing was read;
 * - a voltage is inside the sensor's output range, `kOutputMinMv` to `kOutputMaxMv`, and a
 *   temperature is that range through the configured transfer function;
 * - every log line is a non-empty plain-text message.
 *
 * Built two ways (tests/fuzz/CMakeLists.txt): with libFuzzer (Clang, `-DXMPL100_BUILD_FUZZERS=ON`),
 * and as a plain executable that replays the corpus in tests/fuzz/corpus/ as a CTest on any
 * compiler.
 */
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>

#include "mock_xmpl100.hpp"
#include "xmpl100.hpp"

namespace {

using xmpl100::Error;

/// The fuzzer's bytes, read front to back; zeros once they run out.
class Input {
public:
  Input(const uint8_t* data, std::size_t size) noexcept : data_(data), size_(size) {}

  [[nodiscard]] bool Empty() const noexcept {
    return pos_ >= size_;
  }
  uint8_t Byte() noexcept {
    return pos_ < size_ ? data_[pos_++] : uint8_t{0};
  }
  uint16_t Word() noexcept {
    const auto high = Byte();
    return static_cast<uint16_t>((high << 8U) | Byte());
  }

private:
  const uint8_t* data_;
  std::size_t size_;
  std::size_t pos_ = 0;
};

/// A broken promise: name the line and abort, so libFuzzer saves the input as a crash.
void Check(bool promise, int line = __builtin_LINE()) noexcept {
  if (!promise) {
    (void)std::fprintf(stderr, "fuzz_xmpl100: promise broken at line %d\n", line);
    std::abort();
  }
}

/// What the ADC does with one conversion, chosen by the fuzzer; any other value passes it.
constexpr uint8_t kFail = 0xFF;    ///< The conversion fails.
constexpr uint8_t kReplace = 0xFD; ///< The reading is any voltage the fuzzer picks.

/// The port: the sensor model of the host tests behind an ADC the fuzzer controls.
class FuzzPort : public xmpl100::SpiInterface<FuzzPort> {
public:
  explicit FuzzPort(Input& in) noexcept : in_(in) {}

  [[nodiscard]] bool EnsureInitialized() const noexcept {
    return bus_up_ok_;
  }

  bool ReadVoltageMv(uint8_t channel, uint32_t& voltage_mv) noexcept {
    const uint8_t action = nextAction();
    if (action == kFail) {
      return false;
    }
    if (action == kReplace) {
      voltage_mv = in_.Word();
      return true;
    }
    return sensor_.Convert(channel, voltage_mv);
  }

  void DelayUs(uint32_t us) noexcept {
    (void)us;
  }

  /// SHDN_N of the model; the fuzzer may fail the pin write.
  bool GpioSet(xmpl100::CtrlPin pin, xmpl100::GpioSignal signal) noexcept {
    Check(pin == xmpl100::CtrlPin::Enable);
    if (nextAction() == kFail) {
      return false;
    }
    sensor_.powered = signal == xmpl100::GpioSignal::ACTIVE;
    return true;
  }

  /// The driver logs plain text: one non-empty line, never a format string.
  void Log(xmpl100::LogLevel level, const char* message) noexcept {
    (void)level;
    Check(message != nullptr && message[0] != '\0');
  }

  xmpl100_test::MockBusState& Sensor() noexcept {
    return sensor_;
  }
  /// Conversions and pin writes so far.
  [[nodiscard]] int Transfers() const noexcept {
    return transfers_;
  }
  void SetBusUp(bool ok) noexcept {
    bus_up_ok_ = ok;
  }

private:
  /// Count one access and let the fuzzer decide what happens to it.
  uint8_t nextAction() noexcept {
    transfers_++;
    return in_.Byte();
  }

  Input& in_;
  xmpl100_test::MockBusState sensor_;
  int transfers_ = 0;
  bool bus_up_ok_ = true;
};

using Driver = xmpl100::XMPL100<FuzzPort>;

/// The errors this driver returns; `Timeout`, `Crc` and `Busy` never.
bool KnownError(Error e) noexcept {
  switch (e) {
  case Error::Ok:
  case Error::NotInitialized:
  case Error::InvalidArgument:
  case Error::Bus:
  case Error::DeviceIdMismatch:
  case Error::DeviceFault:
  case Error::Unsupported:
    return true;
  case Error::Timeout:
  case Error::Crc:
  case Error::Busy:
    return false;
  }
  return false;
}

/// A configuration from the fuzzer's bytes; sometimes invalid on purpose.
xmpl100::Config FuzzConfig(Input& in) noexcept {
  xmpl100::Config c{};
  const uint8_t flags = in.Byte();
  if ((flags & 0x01U) != 0U) {
    c.channel = static_cast<uint8_t>(in.Byte() % 3U);   // the model is wired to channel 0
    c.offset_mv = in.Word() % 2000U;                    // above kOutputMaxMv is invalid
    c.slope_uv_per_c = in.Word();                       // 0 is invalid
    c.samples = static_cast<uint16_t>(in.Byte() % 70U); // 0 and above kMaxSamples are invalid
    c.sample_interval_us = in.Byte();
  }
  return c;
}

/// Change the sensor between two calls.
void FuzzSensor(xmpl100_test::MockBusState& sensor, Input& in) noexcept {
  switch (in.Byte() % 4U) {
  case 0:
    // -40 to +125 °C, where the model's output is defined; kReplace covers every other voltage.
    sensor.temperature_c = static_cast<float>(in.Byte() % 166U) - 40.0F;
    break;
  case 1:
    sensor.open_output = !sensor.open_output;
    break;
  case 2:
    sensor.wired_channel = static_cast<uint8_t>(in.Byte() % 3U);
    break;
  default:
    sensor.powered = !sensor.powered;
    break;
  }
}

/// The promises of a call that needs a started driver.
template <typename R>
void CheckCommon(const Driver& d, const R& r, bool was_up, int sent) noexcept {
  Check(KnownError(r.error));
  if (!was_up) {
    Check(r.error == Error::NotInitialized && sent == 0 && !d.IsInitialized());
  }
  if (r.error == Error::InvalidArgument) {
    Check(sent == 0);
  }
}

/// The temperature the driver computes from `mv`, the same way it does.
float ToCelsius(const xmpl100::Config& c, uint32_t mv) noexcept {
  const float delta_mv = static_cast<float>(mv) - static_cast<float>(c.offset_mv);
  return delta_mv * 1000.0F / static_cast<float>(c.slope_uv_per_c);
}

void RunOne(Driver& d, FuzzPort& port, Input& in) noexcept {
  const uint8_t op = in.Byte() % 6U;
  const bool was_up = d.IsInitialized();
  const int before = port.Transfers();
  const auto sent = [&] { return port.Transfers() - before; };

  switch (op) {
  case 0: {
    const auto r = d.EnsureInitialized();
    Check(KnownError(r.error) && r.ok() == d.IsInitialized());
    if (was_up || r.error == Error::InvalidArgument) {
      Check(r.ok() == was_up && sent() == 0);
    }
    break;
  }
  case 1: {
    const auto r = d.Deinitialize();
    Check(KnownError(r.error) && !d.IsInitialized());
    if (!was_up) {
      Check(r.ok() && sent() == 0);
    }
    break;
  }
  case 2: {
    const auto r = d.Sleep();
    CheckCommon(d, r, was_up, sent());
    Check(!d.IsInitialized() || !r.ok());
    break;
  }
  case 3: {
    const auto r = d.ReadVoltageMv();
    CheckCommon(d, r, was_up, sent());
    if (r) {
      Check(r.value >= xmpl100::kOutputMinMv && r.value <= xmpl100::kOutputMaxMv);
    } else {
      Check(r.value == 0U);
    }
    break;
  }
  case 4: {
    const auto r = d.ReadTemperatureC();
    CheckCommon(d, r, was_up, sent());
    if (r) {
      const xmpl100::Config& c = d.GetConfig();
      Check(r.value >= ToCelsius(c, xmpl100::kOutputMinMv) &&
            r.value <= ToCelsius(c, xmpl100::kOutputMaxMv));
    } else {
      Check(r.value == 0.0F);
    }
    break;
  }
  default:
    FuzzSensor(port.Sensor(), in);
    port.SetBusUp((in.Byte() & 0x07U) != 0U);
    break;
  }
}

} // namespace

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, std::size_t size) {
  Input in(data, size);
  FuzzPort port(in);
  Driver driver(port, FuzzConfig(in));
  for (int calls = 0; calls < 64 && !in.Empty(); ++calls) {
    RunOne(driver, port, in);
  }
  return 0;
}
