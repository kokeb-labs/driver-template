/**
 * @file xmpl100_spi_interface.hpp
 * @brief The ADC port of the XMPL100 driver: the CRTP base, its pin enums and the `SpiPort`
 * concept.
 * @copyright Copyright (c) 2026 The Kokeb Labs Authors. SPDX-License-Identifier: MIT
 *
 * @details
 * The XMPL100 has an analog output, read through an ADC channel of your MCU. The driver calls hooks
 * on a class you derive from `xmpl100::SpiInterface<Self>`:
 *
 * | Hook | Contract |
 * | --- | --- |
 * | `bool EnsureInitialized() noexcept` | Bring the ADC up on the first call; `true` at once
 * afterwards | | `bool ReadVoltageMv(uint8_t channel, uint32_t& voltage_mv) noexcept` | One
 * calibrated conversion of `channel`, in millivolts; `false` on an error |
 *
 * The port converts raw counts to millivolts with the MCU's calibration; the driver never
 * configures the ADC (attenuation, width, sampling time).
 */
#pragma once

#include <concepts>
#include <cstdint>

namespace xmpl100 {

/** @brief Control pins the port may drive through the optional `GpioSet()` hook. */
enum class CtrlPin : uint8_t {
  Enable = 0, ///< SHDN_N, active low shutdown; ACTIVE means the sensor is powered.
};

/** @brief Logical level of a control pin; the port maps it to the physical polarity. */
enum class GpioSignal : uint8_t {
  INACTIVE = 0, ///< The pin function is deasserted.
  ACTIVE = 1,   ///< The pin function is asserted.
};

/**
 * @brief CRTP base of the platform ADC port.
 *
 * The base declares no hook itself (a forwarding hook would turn a missing override into infinite
 * recursion); the driver checks your class with the `SpiPort` concept.
 *
 * @tparam Derived Your port class.
 */
template <typename Derived>
class SpiInterface {
public:
  /** @brief Ports are not copied: the driver holds a reference. */
  SpiInterface(const SpiInterface&) = delete;
  /** @brief Ports are not copied: the driver holds a reference. */
  SpiInterface& operator=(const SpiInterface&) = delete;

protected:
  /** @brief Only the derived port is constructed. */
  SpiInterface() noexcept = default;
  /** @brief Destroyed through the derived port only. */
  ~SpiInterface() noexcept = default;
};

/**
 * @brief Satisfied by a class that derives from `SpiInterface<Port>` and implements the required
 * hooks with the right types.
 * @tparam Port The port class.
 */
template <typename Port>
concept SpiPort = std::derived_from<Port, SpiInterface<Port>> &&
                  requires(Port& port, uint8_t channel, uint32_t& voltage_mv) {
                    { port.EnsureInitialized() } -> std::same_as<bool>;
                    { port.ReadVoltageMv(channel, voltage_mv) } -> std::same_as<bool>;
                  };

} // namespace xmpl100
