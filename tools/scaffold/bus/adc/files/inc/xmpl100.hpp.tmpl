namespace xmpl100 {

namespace detail {

// Optional hooks: a `Declares*` concept only tests the name, the `Has*` concept the exact
// signature, `noexcept` and the result type; the driver rejects a hook that is declared but does not
// match (handbook KB-CPP20-007).

/// The port declares something called `GpioSet` (used to reject a misdeclared hook).
template <typename Port>
concept DeclaresGpioSet =
    requires(Port& port) { port.GpioSet(CtrlPin::Enable, GpioSignal::ACTIVE); };

/// The port drives control pins: `bool GpioSet(CtrlPin, GpioSignal) noexcept`.
template <typename Port>
concept HasGpioSet =
    requires(Port& port, Exactly<CtrlPin> pin, Exactly<GpioSignal> signal) {
      { port.GpioSet(pin, signal) } noexcept -> std::same_as<bool>;
    };

/// The port declares something called `DelayUs`.
template <typename Port>
concept DeclaresDelayUs = requires(Port& port) { port.DelayUs(1U); };

/// The port waits: `void DelayUs(uint32_t us) noexcept`.
template <typename Port>
concept HasDelayUs = requires(Port& port, Exactly<uint32_t> us) {
  { port.DelayUs(us) } noexcept -> std::same_as<void>;
};

/// The port declares something called `Log`.
template <typename Port>
concept DeclaresLog = requires(Port& port) { port.Log(LogLevel::Info, ""); };

/// The port takes log lines: `void Log(LogLevel, const char* message) noexcept`.
template <typename Port>
concept HasLog =
    requires(Port& port, Exactly<LogLevel> level, Exactly<const char*> message) {
      { port.Log(level, message) } noexcept -> std::same_as<void>;
    };

/// Wait through the port; a port without `DelayUs()` fails to compile at the first wait.
template <typename Port>
void DelayUs(Port& port, uint32_t us) noexcept {
  if constexpr (HasDelayUs<Port>) {
    port.DelayUs(us);
  } else {
    static_assert(kAlwaysFalse<Port>,
                  "xmpl100: the port must implement `void DelayUs(uint32_t us) noexcept`");
  }
}

/// Log through the port, or nothing when the port has no `Log()`.
template <typename Port>
void Log(Port& port, [[maybe_unused]] LogLevel level,
         [[maybe_unused]] const char* message) noexcept {
  if constexpr (HasLog<Port>) {
    port.Log(level, message);
  } else {
    (void)port;
  }
}

} // namespace detail

/**
 * @defgroup xmpl100_driver XMPL100 driver
 * @brief The driver class.
 * @{
 */

/**
 * @brief Driver for one XMPL100 analog temperature sensor on an ADC port.
 *
 * Lifecycle: construct with the configuration (no I/O), then `EnsureInitialized()`, the one way
 * to start, use, optionally `Deinitialize()`. Every call that touches the sensor returns
 * `Error::NotInitialized` until `EnsureInitialized()` has succeeded; no call starts it as a side
 * effect.
 *
 * Optional hooks: `void DelayUs(uint32_t)` (required by every wait: a missing one is a compile
 * error), `bool GpioSet(CtrlPin, GpioSignal)` (SHDN_N; without it `Sleep()` returns `Unsupported`),
 * `void Log(LogLevel, const char* message)`.
 *
 * @tparam Port Your class derived from `SpiInterface<Port>`.
 */
template <SpiPort Port>
class XMPL100 {
  static_assert(!detail::DeclaresGpioSet<Port> || detail::HasGpioSet<Port>,
                "xmpl100: the optional GpioSet hook must be `bool GpioSet(CtrlPin, GpioSignal) "
                "noexcept`, so that a failed pin write is reported");
  static_assert(!detail::DeclaresDelayUs<Port> || detail::HasDelayUs<Port>,
                "xmpl100: the DelayUs hook must be `void DelayUs(uint32_t us) noexcept`, so that no "
                "wait is truncated");
  static_assert(!detail::DeclaresLog<Port> || detail::HasLog<Port>,
                "xmpl100: the optional Log hook must be `void Log(LogLevel, const char* message) "
                "noexcept`");

public:
  /**
   * @brief Bind the driver to a port and store the configuration. No I/O, cannot fail.
   * @param port The port; it must outlive the driver.
   * @param config The channel and the transfer function, applied by `EnsureInitialized()` and
   * checked there, before any I/O.
   */
  explicit XMPL100(Port& port, const Config& config = {}) noexcept : port_(port), config_(config) {}

  /** @brief One driver object per sensor. */
  XMPL100(const XMPL100&) = delete;
  /** @brief One driver object per sensor. */
  XMPL100& operator=(const XMPL100&) = delete;

  /**
   * @brief Start the sensor, once: the only way to initialise the driver.
   *
   * The first call brings the ADC up, powers the sensor (SHDN_N, when the port has `GpioSet()`),
   * waits t_ON and checks that the output is inside the sensor's range: the closest equivalent of
   * a chip-ID check. After it succeeds, later calls return `Ok` at once with no I/O. After it
   * fails, the driver stays uninitialised and the next call starts again from the beginning.
   *
   * @return `Ok`, `InvalidArgument` (the stored configuration fails `Validate()`; no I/O), `Bus`
   *         or `DeviceIdMismatch` (no sensor on the channel).
   */
  Result<void> EnsureInitialized() noexcept;

  /** @return true after a successful `EnsureInitialized()`. No I/O. */
  [[nodiscard]] bool IsInitialized() const noexcept {
    return initialized_;
  }

  /**
   * @brief Shut the sensor down when the port drives SHDN_N, and mark the driver uninitialised;
   * the next `EnsureInitialized()` starts it again (the recovery after a fault).
   * @return `Ok` or `Bus` (the pin write failed).
   */
  Result<void> Deinitialize() noexcept;

  /**
   * @brief Shut the sensor down; `EnsureInitialized()` powers it again.
   * @return `Ok`, `NotInitialized`, `Unsupported` (no `GpioSet()`) or `Bus`.
   */
  Result<void> Sleep() noexcept;

  /**
   * @brief Read the output, averaged over `Config::samples` conversions.
   * @return Millivolts, or `NotInitialized`, `Bus` or `DeviceFault` (outside the sensor's range).
   */
  Result<uint32_t> ReadVoltageMv() noexcept;

  /**
   * @brief Read the temperature with the configured transfer function.
   * @return Degrees Celsius, or the errors of `ReadVoltageMv()`.
   */
  Result<float> ReadTemperatureC() noexcept;

  /** @return The configuration stored or last applied. No I/O. */
  [[nodiscard]] const Config& GetConfig() const& noexcept {
    return config_;
  }
  /** @brief Not on a temporary driver: the reference would dangle (handbook KB-CPP20-044). */
  void GetConfig() const&& = delete;

  /**
   * @brief One conversion, once: no averaging, no range check, no retry (handbook KB-CPP-129).
   * For bring-up and diagnostics.
   * @return Millivolts as the port read them, or `NotInitialized` or `Bus`.
   */
  Result<uint32_t> ReadRawVoltageMv() noexcept;

  /** @return The last single conversion any read made, in millivolts; 0 before the first. No I/O. */
  [[nodiscard]] uint32_t GetLastVoltageMv() const noexcept {
    return last_mv_;
  }

private:
  Result<void> initialize() noexcept;
  Result<uint32_t> readAveraged() noexcept;
  Result<uint32_t> readOnce() noexcept;

  Port& port_;
  Config config_{};
  uint32_t last_mv_{0}; ///< The last single conversion (GetLastVoltageMv()).
  bool initialized_{false};
};

/** @} */

} // namespace xmpl100

#include "../src/xmpl100.ipp" // IWYU pragma: export

#endif // XMPL100_HPP
