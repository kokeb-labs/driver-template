/**
 * @file xmpl100_version.h
 * @brief XMPL100 driver version, generated by CMake from xmpl100_version.h.in.
 * @copyright Copyright (c) 2026 The driver-template authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/xmpl100_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef XMPL100_VERSION_H
#define XMPL100_VERSION_H

/** Major version: incompatible API changes. */
#define XMPL100_VERSION_MAJOR @XMPL100_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define XMPL100_VERSION_MINOR @XMPL100_VERSION_MINOR@
/** Patch version: fixes. */
#define XMPL100_VERSION_PATCH @XMPL100_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define XMPL100_VERSION_STRING "@XMPL100_VERSION@"

#endif // XMPL100_VERSION_H
